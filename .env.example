# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Authorized monitoring integrations
# Add API tokens as Replit Secrets; do not commit them to this file.
SAT_VALIDATION_URL="https://authorized-provider.example/sat"
SAT_API_TOKEN=""
SAT_RATE_LIMIT_PER_MINUTE="30"
IMSS_VALIDATION_URL="https://authorized-provider.example/imss"
IMSS_API_TOKEN=""
IMSS_RATE_LIMIT_PER_MINUTE="30"
FINANCIAL_VALIDATION_URL="https://authorized-provider.example/financial"
FINANCIAL_API_TOKEN=""
FINANCIAL_RATE_LIMIT_PER_MINUTE="30"
LEGAL_VALIDATION_URL="https://authorized-provider.example/legal"
LEGAL_API_TOKEN=""
LEGAL_RATE_LIMIT_PER_MINUTE="30"

# Independent worker
MONITORING_WORKER_POLL_MS="5000"

# Optional Features
ENABLE_GOOGLE_AUTH=false
